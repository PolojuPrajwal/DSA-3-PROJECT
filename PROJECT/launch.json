{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run web server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: attribute query_song.txt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--query", "data/query_song.txt"],
      "console": "integratedTerminal"
    },
    {
      "name": "Benchmark",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/benchmark.py",
      "console": "integratedTerminal"
    }
  ]
}
